{%- comment -%}NOON MATCHA brand font preloads (replaces Dawn's Shopify-font preload).{%- endcomment -%}
{% comment %}theme-check-disable AssetPreload{% endcomment %}
<link rel="preload" as="font" href="{{ 'BootzyTM.woff2' | asset_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ 'RobotoMono-Variable.ttf' | asset_url }}" type="font/ttf" crossorigin>
{% comment %}theme-check-enable AssetPreload{% endcomment %}
