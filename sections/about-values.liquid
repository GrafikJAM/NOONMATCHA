{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noon-about-values__header {
    max-width: 56rem;
    margin: 0 auto 4rem;
  }

  .noon-about-values__header.noon-title-wrapper--center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .noon-about-values__heading {
    margin: 0;
  }

  .noon-about-values__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3.6rem 3.2rem;
  }

  .noon-about-values__item {
    flex: 0 0 100%;
    max-width: 100%;
  }

  @media screen and (min-width: 750px) {
    .noon-about-values__item {
      flex: 0 0 calc((100% - 3.2rem) / 2);
      max-width: calc((100% - 3.2rem) / 2);
    }
  }

  @media screen and (min-width: 990px) {
    .noon-about-values__item {
      flex: 0 0 calc((100% - 3.2rem * 2) / 3);
      max-width: calc((100% - 3.2rem * 2) / 3);
    }
  }

  .noon-about-values__number {
    display: block;
    color: rgb(var(--color-accent, var(--color-foreground)));
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 1.4rem;
  }

  .noon-about-values__title {
    margin: 0 0 0.8rem;
    font-size: 1.9rem;
    font-weight: 700;
  }

  .noon-about-values__text {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.75);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="noon-about-values__header{% if section.settings.heading_alignment == 'center' %} noon-title-wrapper--center{% endif %}">
      {%- if section.settings.heading != blank -%}
        <h2 class="noon-about-values__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="noon-about-values__grid">
        {%- for block in section.blocks -%}
          <div class="noon-about-values__item" {{ block.shopify_attributes }}>
            <span class="noon-about-values__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="noon-about-values__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="noon-about-values__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About values",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vērtības"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left",
      "label": "Heading alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About values",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
