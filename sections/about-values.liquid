{{ 'noon-text-scale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noon-about-values__header {
    max-width: 56rem;
    margin: 0 auto 4rem;
  }

  .noon-about-values__header.noon-title-wrapper--center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .noon-about-values__header > p,
  .noon-about-values__header > h2 {
    margin: 0;
  }

  .noon-about-values__header > p + h2 {
    margin-top: 0.8rem;
  }

  .noon-about-values__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.4rem;
  }

  .noon-about-values__item {
    flex: 0 0 100%;
    max-width: 100%;
    display: flex;
  }

  @media screen and (min-width: 750px) {
    .noon-about-values__item {
      flex: 0 0 calc((100% - 2.4rem) / 2);
      max-width: calc((100% - 2.4rem) / 2);
    }
  }

  @media screen and (min-width: 990px) {
    .noon-about-values__item {
      flex: 0 0 calc((100% - 2.4rem * 2) / 3);
      max-width: calc((100% - 2.4rem * 2) / 3);
    }
  }

  .noon-value-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 27rem;
    padding: 2.8rem;
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.12);
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .noon-value-card--image {
    justify-content: flex-end;
    border-color: transparent;
    color: rgb(255, 255, 255);
  }

  .noon-value-card--image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 40%, rgba(0, 0, 0, 0.75) 100%);
  }

  .noon-value-card__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.6rem;
    align-content: start;
  }

  .noon-value-card__number {
    display: block;
    font-size: 1.4rem;
    letter-spacing: 0.2em;
    color: rgb(var(--color-noon-green, 125, 222, 18));
  }

  .noon-value-card--image .noon-value-card__number {
    color: rgb(var(--color-noon-green, 125, 222, 18));
  }

  .noon-value-card__title {
    margin: 0;
    font-weight: 700;
  }

  .noon-value-card__text {
    margin: 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  .noon-value-card--image .noon-value-card__text {
    color: rgba(255, 255, 255, 0.9);
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="noon-about-values__header{% if section.settings.heading_alignment == 'center' %} noon-title-wrapper--center{% endif %}">
      {%- if section.settings.caption != blank -%}
        <p class="caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="noon-about-values__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="noon-about-values__grid">
        {%- for block in section.blocks -%}
          <div class="noon-about-values__item" {{ block.shopify_attributes }}>
            <div
              class="noon-value-card{% if block.settings.image != blank %} noon-value-card--image{% endif %} color-{{ block.settings.color_scheme }}"
              {% if block.settings.image != blank %}
                style="background-image: url({{ block.settings.image | image_url: width: 900 }});"
              {% endif %}
            >
              <div class="noon-value-card__content">
                <span class="noon-value-card__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- if block.settings.title != blank -%}
                  <h3 class="noon-value-card__title {{ block.settings.heading_size }}">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="noon-value-card__text {{ block.settings.text_size }}">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "About values",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vērtības"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h5", "label": "Small" },
            { "value": "h4", "label": "Medium" },
            { "value": "h3", "label": "Large" },
            { "value": "h2", "label": "Extra large" }
          ],
          "default": "h4",
          "label": "Title size"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            { "value": "noon-text-s", "label": "Small" },
            { "value": "noon-text-m", "label": "Medium" },
            { "value": "noon-text-l", "label": "Large" },
            { "value": "noon-text-xl", "label": "Extra large" }
          ],
          "default": "noon-text-m",
          "label": "Text size"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Card color scheme (used when no image is set)",
          "default": "scheme-2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About values",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
