{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noon-about-statement {
    max-width: 74rem;
    margin: 0 auto;
    text-align: center;
  }

  .noon-about-statement__text {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1.3;
    letter-spacing: 0.01rem;
  }

  @media screen and (min-width: 750px) {
    .noon-about-statement__text {
      font-size: 3.8rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="noon-about-statement">
      {%- if section.settings.text != blank -%}
        <p class="noon-about-statement__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About statement",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Statement",
      "default": "NOON MATCHA nav tikai tēja. Tā ir izvēle — par mieru, fokusu un sevi ik dienas."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    { "name": "About statement" }
  ]
}
{% endschema %}
