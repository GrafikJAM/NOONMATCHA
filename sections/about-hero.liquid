{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noon-about-hero__title {
    margin: 0 0 3.2rem;
  }

  .noon-about-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }

  @media screen and (min-width: 750px) {
    .noon-about-hero__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: 6rem;
      align-items: start;
    }
  }

  .noon-about-hero--centered .noon-about-hero__title {
    text-align: center;
  }

  .noon-about-hero__grid--centered {
    max-width: 62rem;
    margin: 0 auto;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .noon-about-hero__grid--centered {
      grid-template-columns: 1fr;
    }
  }

  .noon-about-hero__heading {
    margin: 0;
  }

  .noon-about-hero__lead {
    margin: 0;
    font-size: 1.9rem;
    line-height: 1.45;
  }

  .noon-about-hero__body > * {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.75);
  }

  .noon-about-hero__body > * + * {
    margin-top: 1.6rem;
  }
{%- endstyle -%}

{%- assign noon_hero_centered = false -%}
{%- if section.settings.heading == blank -%}
  {%- assign noon_hero_centered = true -%}
{%- endif -%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if noon_hero_centered %} noon-about-hero--centered{% endif %}">
  <div class="page-width section-{{ section.id }}-padding">
    <h1 class="noon-about-hero__title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>

    <div class="noon-about-hero__grid{% if noon_hero_centered %} noon-about-hero__grid--centered{% endif %}">
      {%- unless noon_hero_centered -%}
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="noon-about-hero__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      {%- endunless -%}
      <div>
        {%- if section.settings.intro_text != blank -%}
          <div class="noon-about-hero__lead">{{ section.settings.intro_text }}</div>
        {%- endif -%}
        {%- if section.settings.body_text != blank -%}
          <div class="noon-about-hero__body">{{ section.settings.body_text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NOON MATCHA dzima dienas vidū"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Lead paragraph",
      "default": "<p>Tieši tajā brīdī, kad saule ir visaugstāk debesīs, bet mūsu enerģija sāk dzist. Pēc pusdienām — kad prāts kļūst miglains, un ķermenis meklē līdzsvaru — mēs vēlējāmies atrast dabisku veidu, kā atjaunoties. Nevis ar vēl vienu kafijas krūzi vai cukuru. Bet ar kaut ko dziļāku. Klusāku. Spēcīgāku.</p>"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Supporting text",
      "default": "<p>Mēs atradām atbildi Japānas senajā matcha rituālā — tajā brīdī, kad tēja nav tikai dzēriens, bet apzināts mirklis sev. NOON MATCHA radās, lai piedāvātu augstvērtīgu ceremoniālo matcha, kas sniedz ilgstošu, mierpilnu enerģiju un skaidrību, ko nevar salīdzinq ar mākslīgiem stimulatoriem.</p><p>Mēs ticam, ka enerģija un estētika var būt apvienoti. Tāpēc rūpīgi izvēlamies tikai augstākās kvalitātes matcha no Japānas, un piedāvājam arī izsmalcinātus piederumus, kas padara pagatavošanas rituālu vienkāršu, skaistu un personīgu.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "presets": [
    { "name": "About hero" }
  ]
}
{% endschema %}
