{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'noon-text-scale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }

  .collection-hero__description-button {
    margin-top: 1.6rem;
    text-align: center;
  }
{%- endstyle -%}

{%- liquid
  comment
    This section can be added TWICE to the same collection template: once
    near the top with description_mode "auto" (short teaser, from the
    "Short description" metafield or an auto-trimmed Description, with a
    "read more" button), and again further down -- after the product grid
    -- with description_mode "full" (the plain, untrimmed Description,
    title turned off). No separate "full description" section needed;
    just duplicate this one and flip its settings.
  endcomment
  assign noon_full_desc = collection.description | strip_html | strip_newlines
  assign noon_mode = section.settings.description_mode | default: 'auto'

  if noon_mode == 'full'
    assign noon_display_desc = collection.description
    assign noon_show_button = false
  else
    assign noon_short_meta = collection.metafields.custom.short_description.value
    if noon_short_meta != blank
      assign noon_short_desc = noon_short_meta | strip_html | strip_newlines
      assign noon_desc_truncated = false
      if noon_full_desc != blank
        assign noon_desc_truncated = true
      endif
    else
      assign noon_word_limit = section.settings.short_description_word_limit
      assign noon_short_desc = noon_full_desc | truncatewords: noon_word_limit
      assign noon_word_count = noon_full_desc | split: ' ' | size
      assign noon_desc_truncated = false
      if noon_word_count > noon_word_limit
        assign noon_desc_truncated = true
      endif
    endif
    assign noon_display_desc = noon_short_desc
    assign noon_show_button = false
    if noon_desc_truncated and section.settings.button_label != blank
      assign noon_show_button = true
    endif
  endif
-%}

<div
  {%- if noon_mode == 'full' %} id="collection-full-description"{% endif %}
  class="collection-hero section-{{ section.id }}-padding{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient"
>
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- if section.settings.show_title -%}
        <h1 class="collection-hero__title">
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {{- collection.title | escape -}}
        </h1>
      {%- endif -%}

      {%- if section.settings.show_collection_description and noon_display_desc != blank -%}
        <div class="collection-hero__description rte {{ section.settings.text_size }}">{{ noon_display_desc }}</div>

        {%- if noon_show_button -%}
          <div class="collection-hero__description-button">
            <a href="#collection-full-description" class="button button--secondary">
              {{- section.settings.button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "paragraph",
      "content": "Tip: add this section twice on the same collection template -- once near the top set to 'Automatic' (short teaser + read more button), and again after the product grid set to 'Full / regular' with the title turned off, to show the complete Description lower on the page."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "default": true,
      "label": "Show collection title",
      "info": "Turn off when duplicating this section lower on the page just to show the full description."
    },
    {
      "type": "select",
      "id": "description_mode",
      "options": [
        { "value": "auto", "label": "Automatic (short teaser + read more button)" },
        { "value": "full", "label": "Full description (untrimmed)" }
      ],
      "default": "auto",
      "label": "Description mode"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "range",
      "id": "short_description_word_limit",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40,
      "label": "Short description length (words)",
      "info": "Only used in 'Automatic' mode, and only when the collection has no 'Short description' metafield set."
    },
    {
      "type": "select",
      "id": "text_size",
      "options": [
        { "value": "noon-text-s", "label": "Small" },
        { "value": "noon-text-m", "label": "Medium" },
        { "value": "noon-text-l", "label": "Large" },
        { "value": "noon-text-xl", "label": "Extra large" }
      ],
      "default": "noon-text-l",
      "label": "Description text size"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Read more button label",
      "default": "Uzzini vairāk",
      "info": "Only used in 'Automatic' mode, and only shown when the description is actually trimmed. Jumps down to wherever a second copy of this section (set to 'Full / regular') is placed."
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}