{{ 'noon-text-scale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noon-wholesale {
    max-width: 64rem;
    margin: 0 auto;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 2rem;
  }

  .noon-wholesale > p,
  .noon-wholesale > h2,
  .noon-wholesale > div.rte {
    margin: 0;
  }

  .noon-wholesale__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem 2.4rem;
    font-family: var(--font-body-family);
  }

  .noon-wholesale__list li::before {
    content: '— ';
    opacity: 0.5;
  }

  .noon-section {
    position: relative;
  }

  .noon-section--bg-image {
    background-image: var(--noon-bg-image);
    background-size: cover;
    background-position: center;
  }

  .noon-section__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .noon-section__overlay {
    opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};
  }

  .noon-section__inner {
    position: relative;
    z-index: 1;
  }
{%- endstyle -%}

{%- liquid
  assign noon_has_bg_image = false
  if section.settings.background_image != blank
    assign noon_has_bg_image = true
  endif
  assign noon_full_width = section.settings.full_width
-%}
<div
  class="noon-section{% unless noon_full_width %} page-width{% endunless %} color-{{ section.settings.color_scheme }} gradient{% if noon_has_bg_image %} noon-section--bg-image{% endif %}"
  {%- if noon_has_bg_image %}
    style="--noon-bg-image: url('{{ section.settings.background_image | image_url: width: 3840 }}');"
  {%- endif %}
>
  {%- if noon_has_bg_image and section.settings.background_overlay_opacity > 0 -%}
    <div class="noon-section__overlay"></div>
  {%- endif -%}
  <div class="{% if noon_full_width %}page-width {% endif %}isolate section-{{ section.id }}-padding noon-section__inner">
  <div class="noon-wholesale">
    {%- if section.settings.caption != blank -%}
      <p class="caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rte {{ section.settings.text_size }}">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="noon-wholesale__list">
        {%- for block in section.blocks -%}
          <li class="{{ block.settings.text_size }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div style="margin-top: 1rem;">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
  </div>

{% schema %}
{
  "name": "Wholesale partnership",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "default": "Kafejnīcām un studijām",
      "label": "Caption"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Piedāvā NOON savā letē",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Sadarbojamies ar nelielu skaitu kafejnīcu, bāru un labsajūtas studiju Rīgā un citur Latvijā, kuras dala mūsu standartu ceremoniālas kvalitātes matcha tējai. Sazinies ar mums, un mēs piedāvāsim vairumtirdzniecības cenas, apmācību un visu nepieciešamo, lai to pasniegtu pareizi.</p>",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_size",
      "options": [
        { "value": "noon-text-s", "label": "Small" },
        { "value": "noon-text-m", "label": "Medium" },
        { "value": "noon-text-l", "label": "Large" },
        { "value": "noon-text-xl", "label": "Extra large" }
      ],
      "default": "noon-text-m",
      "label": "Text size"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Pieteikties vairumtirdzniecībai",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Link to your wholesale inquiry form (e.g. a Google Form) or a contact page."
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "Use secondary button style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make background full width",
      "info": "Background stretches edge to edge; content stays centered.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. Overrides the color scheme background."
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background image overlay opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Vairumtirdzniecības cenas",
          "label": "Label"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            { "value": "noon-text-s", "label": "Small" },
            { "value": "noon-text-m", "label": "Medium" },
            { "value": "noon-text-l", "label": "Large" }
          ],
          "default": "noon-text-s",
          "label": "Text size"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale partnership",
      "blocks": [
        { "type": "highlight", "settings": { "label": "Vairumtirdzniecības cenas" } },
        { "type": "highlight", "settings": { "label": "Personāla apmācība" } },
        { "type": "highlight", "settings": { "label": "Reklāmas materiāli" } }
      ]
    }
  ]
}
{% endschema %}
