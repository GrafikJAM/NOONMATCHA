{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .noon-instagram__header {
    max-width: 56rem;
    margin: 0 auto 3rem;
  }

  .noon-instagram__header.noon-title-wrapper--center {
    margin-left: auto;
    margin-right: auto;
  }

  .noon-instagram__header > p,
  .noon-instagram__header > h2 {
    margin: 0;
  }

  .noon-instagram__header > p + h2 {
    margin-top: 0.8rem;
  }

  .noon-instagram__embed {
    width: 100%;
  }

  .noon-instagram__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 0.6rem;
  }

  @media screen and (min-width: 750px) {
    .noon-instagram__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: 1.2rem;
    }
  }

  .noon-instagram__item {
    position: relative;
    display: block;
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.06);
  }

  .noon-instagram__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .noon-instagram__item--square { aspect-ratio: 1 / 1; }
  .noon-instagram__item--portrait { aspect-ratio: 4 / 5; }
  .noon-instagram__item--landscape { aspect-ratio: 5 / 4; }
  .noon-instagram__item--wide { aspect-ratio: 16 / 9; }

  .noon-instagram__item--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-foreground), 0.4);
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    text-align: center;
    padding: 1rem;
  }

  .noon-instagram__item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(var(--color-foreground), 0.55);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .noon-instagram__item:hover::after,
  .noon-instagram__item:focus-visible::after {
    opacity: 1;
  }

  .noon-instagram__item-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    color: rgb(var(--color-background));
    pointer-events: none;
  }

  .noon-instagram__item:hover .noon-instagram__item-icon,
  .noon-instagram__item:focus-visible .noon-instagram__item-icon {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .noon-instagram__follow {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  .noon-instagram__follow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    letter-spacing: 0.04rem;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 999px;
    padding: 1rem 2rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .noon-instagram__follow-link:hover {
    border-color: rgba(var(--color-foreground), 0.6);
    background: rgba(var(--color-foreground), 0.04);
  }

  .noon-section {
    position: relative;
  }

  .noon-section--bg-image {
    background-image: var(--noon-bg-image);
    background-size: cover;
    background-position: center;
  }

  .noon-section__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .noon-section__overlay {
    opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};
  }

  .noon-section__inner {
    position: relative;
    z-index: 1;
  }
{%- endstyle -%}

{%- liquid
  assign noon_has_bg_image = false
  if section.settings.background_image != blank
    assign noon_has_bg_image = true
  endif
  assign noon_full_width = section.settings.full_width

  assign ratio_class = ''
  if section.settings.image_ratio != 'natural'
    assign ratio_class = ' noon-instagram__item--' | append: section.settings.image_ratio
  endif
-%}
<div
  class="noon-section{% unless noon_full_width %} page-width{% endunless %} color-{{ section.settings.color_scheme }} gradient{% if noon_has_bg_image %} noon-section--bg-image{% endif %}"
  {%- if noon_has_bg_image %}
    style="--noon-bg-image: url('{{ section.settings.background_image | image_url: width: 3840 }}');"
  {%- endif %}
>
  {%- if noon_has_bg_image and section.settings.background_overlay_opacity > 0 -%}
    <div class="noon-section__overlay"></div>
  {%- endif -%}
  <div class="{% if noon_full_width %}page-width {% endif %}isolate section-{{ section.id }}-padding noon-section__inner">
    <div class="noon-instagram__header{% if section.settings.heading_alignment == 'center' %} noon-title-wrapper--center{% endif %}">
      {%- if section.settings.caption != blank -%}
        <p class="caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.embed_code != blank -%}
      <div class="noon-instagram__embed">
        {{ section.settings.embed_code }}
      </div>
    {%- elsif section.blocks.size > 0 -%}
      <div class="noon-instagram__grid">
        {%- assign noon_fallback_products = collections.all.products -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_link = section.settings.instagram_url
            if block.settings.link != blank
              assign item_link = block.settings.link
            endif

            assign noon_ig_image = block.settings.image
            if noon_ig_image == blank and noon_fallback_products.size > 0
              assign noon_fallback_index = forloop.index0 | modulo: noon_fallback_products.size
              assign noon_fallback_product = noon_fallback_products[noon_fallback_index]
              if noon_fallback_product.featured_image != blank
                assign noon_ig_image = noon_fallback_product.featured_image
              endif
            endif
          -%}
          <a
            href="{{ item_link }}"
            target="_blank"
            rel="noopener"
            class="noon-instagram__item{{ ratio_class }}"
            {{ block.shopify_attributes }}
          >
            {%- if noon_ig_image != blank -%}
              {{
                noon_ig_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', widths: '200,400,600,800', alt: block.settings.alt_text
              }}
            {%- else -%}
              <div class="noon-instagram__item--placeholder">Pievieno Instagram foto</div>
            {%- endif -%}
            <span class="noon-instagram__item-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="20" height="20" rx="5"/>
                <circle cx="12" cy="12" r="4.2"/>
                <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/>
              </svg>
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.instagram_url != blank -%}
      <div class="noon-instagram__follow">
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="noon-instagram__follow-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="4.2"/>
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/>
          </svg>
          {{ section.settings.instagram_handle | default: 'Instagram' | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Sekojiet līdzi"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" },
        { "value": "hxl", "label": "Extra extra large" },
        { "value": "hxxl", "label": "Extra extra extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "header",
      "content": "Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile link",
      "info": "Used for the follow button and as the default link for photos without their own link."
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Follow button label",
      "default": "@noonmatcha"
    },
    {
      "type": "header",
      "content": "Live feed (optional)"
    },
    {
      "type": "liquid",
      "id": "embed_code",
      "label": "Embed code",
      "info": "Paste an embed snippet from a feed widget like snapwidget.com to show your real, live Instagram posts automatically. Go to snapwidget.com \u2192 Create a Widget \u2192 Instagram \u2192 connect @noonmatcha \u2192 copy the Embed code \u2192 paste it here. Leave blank to use the manual photo blocks below instead."
    },
    {
      "type": "header",
      "content": "Grid (used when no embed code is set above)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (5:4)" },
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "natural", "label": "Natural (original image)" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make background full width",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "background_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Background image overlay opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Link to this specific Instagram post. Leave blank to use the profile link above."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "info": "Describes the image for accessibility."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
