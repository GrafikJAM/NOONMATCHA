{{ 'noon-text-scale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #collection-full-description {
    scroll-margin-top: 3rem;
  }

  .noon-collection-full__inner {
    max-width: 74rem;
    margin: 0 auto;
  }

  .noon-collection-full__heading {
    margin: 0 0 2rem;
  }

  .noon-collection-full__text {
    color: rgba(var(--color-foreground), 0.85);
  }
{%- endstyle -%}

{%- if section.settings.heading != blank or collection.description != blank -%}
  <div id="collection-full-description" class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="noon-collection-full__inner">
        {%- if section.settings.heading != blank -%}
          <h2 class="noon-collection-full__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if collection.description != blank -%}
          <div class="noon-collection-full__text rte {{ section.settings.text_size }}">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection full description",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Automatically shows the collection's own Description field (set in Shopify Admin → Collection → Description). Place this section after the product grid; the 'Collection intro' section's button jumps down to it."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional heading shown above the full description."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "text_size",
      "options": [
        { "value": "noon-text-s", "label": "Small" },
        { "value": "noon-text-m", "label": "Medium" },
        { "value": "noon-text-l", "label": "Large" },
        { "value": "noon-text-xl", "label": "Extra large" }
      ],
      "default": "noon-text-m",
      "label": "Text size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    { "name": "Collection full description" }
  ]
}
{% endschema %}
